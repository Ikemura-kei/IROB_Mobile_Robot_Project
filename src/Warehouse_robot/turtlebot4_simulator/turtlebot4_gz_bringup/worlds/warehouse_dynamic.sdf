    <!-- Dynamic obstacle. Present only in this world, which the C and A grades
         load; the E grade uses warehouse.sdf and has a static scene.

         Visual only, with no collision geometry, so the robot cannot be
         knocked over by it. It is still seen by the lidar, because a gpu_lidar
         renders the scene rather than querying collisions, so it does show up
         in the costmaps and has to be planned around. -->
    <actor name="Person 0 - Walking">
      <pose>-2 1 0.5 0 0 0</pose>
      <skin>
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <scale>1.0</scale>
      </skin>
      <animation name="walk">
        <filename>https://fuel.gazebosim.org/1.0/Mingfei/models/actor/tip/files/meshes/walk.dae</filename>
        <interpolate_x>true</interpolate_x>
      </animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="0.6">
          <waypoint><time>0</time>  <pose>-2 1 0.5 0 0 0</pose></waypoint>
          <waypoint><time>10</time> <pose>11 1 0.5 0 0 0</pose></waypoint>
          <waypoint><time>11</time> <pose>11 1 0.5 0 0 3.14</pose></waypoint>
          <waypoint><time>21</time> <pose>-4 1 0.5 0 0 3.14</pose></waypoint>
          <waypoint><time>22</time> <pose>-4 1 0.5 0 0 0</pose></waypoint>
        </trajectory>
      </script>
    </actor>

  </world>
