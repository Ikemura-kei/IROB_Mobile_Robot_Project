<?xml version="1.0"?>
<sdf version="1.6">
  <world name="depot">
    <scene>
      <grid>false</grid>
    </scene>
    <physics name="1ms" type="ignored">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system" />
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system" />
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system" />
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system" />
    <!--<plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
        <render_engine>ogre2</render_engine>
    </plugin>-->

    <include>
      <uri>
        https://fuel.gazebosim.org/1.0/OpenRobotics/models/Depot
      </uri>
    </include>

    <!-- ArUco Marker ID 10 -->
    <model name="aruco_marker_10_instance">
      <static>true</static>
      <pose>0.4 -1.68 1.2 0 0 1.5708</pose>
      <link name="marker_link">
        <visual name="marker_visual">
          <geometry>
            <box><size>0.002 0.22 0.22</size></box>
          </geometry>
          <material>
            <diffuse>1 1 1 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
            <pbr>
              <metal>
                <albedo_map>../models/aruco_marker_10/materials/textures/marker_10.png</albedo_map>
              </metal>
            </pbr>
          </material>
        </visual>
        <collision name="marker_collision">
          <geometry>
            <box><size>0.002 0.22 0.22</size></box>
          </geometry>
        </collision>
      </link>
    </model>

  </world>
</sdf>
