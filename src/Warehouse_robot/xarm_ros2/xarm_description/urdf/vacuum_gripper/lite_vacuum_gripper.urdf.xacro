<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="uflite_vacuum_gripper">

  <xacro:macro name="uflite_vacuum_gripper_urdf" params="prefix:='' attach_to:='' attach_xyz:='0 0 0' attach_rpy:='0 0 0' inertial_params_filename:='' ">

    <!-- An inertial table may carry a vacuum_gripper entry, so that one YAML scales
         the whole arm including its tool. The stock tables have no such key, so they
         fall through to the hardcoded values below. -->
    <xacro:property name="vg_from_yaml" value="false"/>
    <xacro:if value="${inertial_params_filename != ''}">
      <xacro:property name="vg_file" value="$(find xarm_description)/config/link_inertial/${inertial_params_filename}.yaml"/>
      <xacro:property name="vg_table" value="${xacro.load_yaml(vg_file)}"/>
      <xacro:if value="${'vacuum_gripper' in vg_table}">
        <xacro:property name="vg_from_yaml" value="true"/>
      </xacro:if>
    </xacro:if>

    <xacro:unless value="${attach_to == ''}">
      <joint name="${prefix}vacuum_gripper_fix" type="fixed">
        <parent link="${attach_to}"/>
        <child link="${prefix}uflite_vacuum_gripper_link"/>
        <origin xyz="${attach_xyz}" rpy="${attach_rpy}"/>
      </joint>
    </xacro:unless>

    <link name="${prefix}uflite_vacuum_gripper_link">
      <xacro:if value="${vg_from_yaml}">
        <xacro:common_link_inertial
          link_inertial_params="${vg_table['vacuum_gripper']}"
          origin_rpy="0 0 0"/>
      </xacro:if>
      <xacro:unless value="${vg_from_yaml}">
        <inertial>
          <origin xyz="0.0 0.0 0.030" rpy="0 0 0" />
          <mass value="0.14" />
          <inertia
            ixx="0.00047106" ixy="3.9292E-07" ixz="2.6537E-06"
            iyy="0.00033072" iyz="-1.0975E-05" izz="0.00025642" />
        </inertial>
      </xacro:unless>
      <xacro:common_link_visual 
        mesh_filename="vacuum_gripper/lite/visual/vacuum_gripper_lite"  
        origin_xyz="0 0 0" 
        origin_rpy="0 0 0"
        material_name="${prefix}White" />
      <xacro:common_link_collision 
        mesh_filename="vacuum_gripper/lite/collision/vacuum_gripper_lite"  
        origin_xyz="0 0 0" 
        origin_rpy="0 0 0" />
    </link>

    <link name="${prefix}link_tcp" />

    <joint name="${prefix}joint_tcp" type="fixed">
      <origin xyz="0 0 0.061" rpy="0 0 0" />
      <parent link="${prefix}uflite_vacuum_gripper_link" />
      <child link="${prefix}link_tcp" />
    </joint>

  </xacro:macro>

</robot>