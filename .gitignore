# colcon build artifacts
/build/
/install/
/log/

# pixi environment (pixi/pixi.toml and pixi/pixi.lock ARE tracked; the env is not).
# The manifest lives in pixi/, so pixi creates its environment there.
/pixi/.pixi/
/.pixi/

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Generated by the pixi-build-ros backend into the source tree (absolute paths
# from whoever built last — noise in every diff)
files.txt
